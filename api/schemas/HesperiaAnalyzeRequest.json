{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HesperiaAnalyzeRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "description": "Natural language text to be analyzed by HESPERIA.",
      "minLength": 1
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_supporting_statements": {
          "type": "boolean",
          "default": true
        },
        "max_supporting_statements": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "return_region_coordinates": {
          "type": "boolean",
          "default": true
        },
        "return_metrics": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "required": ["text"]
}
