{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HesperiaAnalyzeResponse",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dominant_area": {
      "type": "string",
      "description": "Canonical Area label (e.g., TRUTH, CONTROL, GOOD)."
    },
    "dominant_family": {
      "type": "string",
      "description": "Canonical Family label inside the dominant Area."
    },
    "area_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "family_global_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 287
    },
    "loopability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tension_energy": {
      "type": "number",
      "minimum": 0
    },
    "obstacle_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "governance": {
      "type": "string",
      "enum": ["allow", "require_correction", "forbid"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "T": { "type": "number" },
        "T_norm": { "type": "number", "minimum": 0, "maximum": 1 },
        "C": { "type": "number", "minimum": 0, "maximum": 1 },
        "X_A": { "type": "number", "minimum": 0, "maximum": 1 },
        "X_F": { "type": "number", "minimum": 0, "maximum": 1 },
        "fragIndex": { "type": "number", "minimum": 0, "maximum": 1 },
        "areaEntropy": { "type": "number" },
        "evidenceQuality": { "type": "number", "minimum": 0, "maximum": 1 },
        "causalCoherence": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "region_coordinates": {
      "type": "array",
      "description": "Human-readable side labels included in the region.",
      "items": {
        "type": "string",
        "pattern": "^A\\d{2}-F\\d{2}-H\\d{3}-S[0-5]$"
      }
    },
    "supporting_statements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statement_id": { "type": "string" },
          "text": { "type": "string" },
          "side_label": {
            "type": "string",
            "pattern": "^A\\d{2}-F\\d{2}-H\\d{3}-S[0-5]$"
          },
          "tau": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": ["statement_id", "text", "side_label", "tau"]
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string",
      "description": "HESPERIA core version identifier."
    }
  },
  "required": [
    "dominant_area",
    "dominant_family",
    "loopability",
    "tension_energy",
    "obstacle_score",
    "governance",
    "timestamp",
    "version"
  ]
}
