# Hesperia Analyze API — GET /health, POST /hesperia/analyze (v0.6), GPT Actions compliant
# Bearer auth via HESPERIA_API_KEY.
# Create /etc/hesperia/hesperia-api.env with: HESPERIA_API_KEY=<secret>
# Install: sudo cp /data/hesperia/hesperia/tools/scripts/hesperia-api.service /etc/systemd/system/hesperia-api.service
#          sudo systemctl daemon-reload && sudo systemctl enable --now hesperia-api

[Unit]
Description=Hesperia Analyze API (v0.6, GPT Actions)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=igareosh
Group=igareosh
WorkingDirectory=/data/hesperia/hesperia/runtime
EnvironmentFile=-/etc/hesperia/hesperia-api.env
Environment=PYTHONPATH=/data/hesperia/hesperia
Environment=CHROMA_INSTANCE=CHROMA-1
Environment=CHROMA_SERVER_URL=http://192.168.100.62:8002
Environment=HESPERIA_DATA_DIR=/data/hesperia/hesperia
Environment=HESPERIA_ATTRIBUTION_MODE=v06
ExecStart=/data/chroma/venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 9005 --timeout-keep-alive 30
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hesperia-api

[Install]
WantedBy=multi-user.target
