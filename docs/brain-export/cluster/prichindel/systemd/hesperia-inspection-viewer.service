[Unit]
Description=Hesperia D3 inspection viewer (static files, hesperia/ HTTP root)
Documentation=file:///data/workspaces/cursor/hesperia/serve_viewer.sh
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=igareosh
Group=igareosh
WorkingDirectory=/data/workspaces/cursor/hesperia
ExecStart=/usr/bin/python3 -m http.server 8765 --bind 0.0.0.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
